/* キーは英語の文言そのもの（src/l10n.rs）。訳が無いときは英語のまま出る */

/* メニュー：アプリを終了する */
"Quit" = "Salir";

/* メニュー：Sparkle で新しい版を確かめる */
"Check for Updates…" = "Buscar actualizaciones…";

/* メニュー：キャッシュのファイルが無いとき */
"No cache" = "Sin caché";

/* メニュー：ワークスペースが 1 つも分からず、表示するものも無いとき */
"No mentions or DMs" = "No hay menciones ni mensajes directos";

/* メニュー：1 度も取得に成功していないとき */
"Not fetched yet" = "Aún no se ha obtenido";

/* メニュー：最後に取得できた時刻。%@ は「10/28 19:05」の形 */
"Fetched %@" = "Obtenido: %@";

/* メニュー：取得全体の失敗。%@ はエラーの内容 */
"Fetch failed: %@" = "Error al obtener: %@";

/* メニュー：ワークスペースごとの取得の失敗。%1$@ はワークスペース名、%2$@ はエラーの内容 */
"Fetch failed: %1$@ (%2$@)" = "Error al obtener: %1$@ (%2$@)";

/* メニュー：ログイン時の起動の切り替えの失敗。%@ は macOS のエラーの説明 */
"Couldn't change Open at Login (%@)" = "No se pudo cambiar “Abrir al iniciar sesión” (%@)";

/* メニュー：ワークスペースに未読が無いとき */
"None" = "Ninguno";

/* メニュー：一覧をすべて既読として外す */
"Mark All as Read" = "Marcar todo como leído";

/* メニュー：すぐに取得する */
"Fetch Now" = "Obtener ahora";

/* メニュー：前回の取得から間が無く、まだ押せないとき。%@ は残りの秒数 */
"Fetch Now (in %@s)" = "Obtener ahora (en %@ s)";

/* メニュー：取得の順番を待っているとき */
"Waiting to Fetch" = "Esperando para obtener";

/* メニュー：取得しているとき */
"Fetching…" = "Obteniendo…";

/* メニュー：ログイン時に atme を起動する */
"Open at Login" = "Abrir al iniciar sesión";

/* メニュー：ログイン時の起動に、システム設定での承認が要るとき */
"Open at Login (needs approval in System Settings)" = "Abrir al iniciar sesión (requiere aprobación en Ajustes del Sistema)";

/* 通知：個別に出さなかった残りの件数。%@ は件数 */
"And %@ more" = "Y %@ más";

/* メニューと通知：グループ DM の場所の名前 */
"Group DM" = "Mensaje directo de grupo";

/* メニューと通知：本文が空のメッセージ */
"(no text)" = "(sin texto)";

/* ファイルを読めなかった。%@ はファイルのパス */
"Couldn't read %@" = "No se pudo leer %@";

/* 設定や状態のファイルの中身が読み取れない。%@ はファイルのパス */
"The contents of %@ are invalid" = "El contenido de %@ no es válido";

/* 設定ファイルにワークスペースが無い */
"No [[workspace]] is configured" = "No hay ningún [[workspace]] configurado";

/* 設定ファイルで同じ name が 2 回ある。%@ は name */
"Workspace name %@ is duplicated" = "El nombre de espacio de trabajo %@ está duplicado";

/* 環境変数 HOME が無い */
"HOME is not set" = "HOME no está definido";

/* Keychain を読む security コマンドを動かせない */
"Couldn't run the security command" = "No se pudo ejecutar el comando security";

/* Keychain に token が無いなど。%3$@ は security コマンドの出力 */
"Couldn't read service=%1$@ account=%2$@ from the Keychain: %3$@" = "No se pudo leer service=%1$@ account=%2$@ del llavero: %3$@";

/* Keychain の値が文字列として読めない */
"The value of account=%@ in the Keychain isn't UTF-8" = "El valor de account=%@ en el llavero no está en UTF-8";

/* ログ：チャンネルの既読の取得に失敗。%1$@ はチャンネル ID */
"Couldn't read the read state of %1$@: %2$@" = "No se pudo leer el estado de lectura de %1$@: %2$@";

/* ログ：スレッドの既読の取得に失敗。%1$@ はチャンネル ID、%2$@ はスレッドの ts */
"Couldn't read the read state of thread %2$@ in %1$@: %3$@" = "No se pudo leer el estado de lectura del hilo %2$@ en %1$@: %3$@";

/* HTTP の準備に失敗 */
"Couldn't create the HTTP client" = "No se pudo crear el cliente HTTP";

/* Slack の応答にスレッドの親が無い */
"conversations.replies didn't return the thread parent" = "conversations.replies no devolvió el mensaje principal del hilo";

/* Slack の API に接続できない。%@ は API の名前 */
"Couldn't call %@" = "No se pudo llamar a %@";

/* Slack の API が HTTP のエラーを返した */
"%1$@ returned HTTP %2$@" = "%1$@ devolvió HTTP %2$@";

/* Slack の応答を受け取れない */
"Couldn't read the response of %@" = "No se pudo leer la respuesta de %@";

/* Slack の応答の形が想定と違う */
"Couldn't parse the response of %@" = "No se pudo interpretar la respuesta de %@";

/* Slack の API がエラーを返した。%2$@ は Slack のエラーコード（訳さない） */
"%1$@ failed: %2$@" = "%1$@ falló: %2$@";

/* 状態のファイルの保存先が無い */
"No directory to save to" = "No hay carpeta donde guardar";

/* ディレクトリを作れない */
"Couldn't create %@" = "No se pudo crear %@";

/* ファイルの権限を変えられない */
"Couldn't set the permissions of %@" = "No se pudieron establecer los permisos de %@";

/* ファイルを開けない */
"Couldn't open %@" = "No se pudo abrir %@";

/* ファイルに書けない */
"Couldn't write to %@" = "No se pudo escribir en %@";

/* 書いたファイルで置き換えられない */
"Couldn't replace %@" = "No se pudo reemplazar %@";

/* CLI：atme fetch で失敗があった */
"Some workspaces failed to fetch" = "Falló la obtención en algunos espacios de trabajo";

/* ログ：users.info の失敗。%1$@ はワークスペース、%2$@ はユーザー ID */
"%1$@: couldn't look up the display name of %2$@: %3$@" = "%1$@: no se pudo obtener el nombre visible de %2$@: %3$@";

/* ログ：自動アップデートの準備に失敗 */
"Couldn't load Sparkle.framework" = "No se pudo cargar Sparkle.framework";

/* .app の外から引数なしで起動した */
"Can't stay in the menu bar because atme was run outside atme.app" = "No se puede permanecer en la barra de menús porque atme se ejecutó fuera de atme.app";

/* 内部のエラー */
"Not running on the main thread" = "No se está ejecutando en el hilo principal";

/* ログ：通知の許可の問い合わせに失敗 */
"Couldn't ask for notification permission: %@" = "No se pudo solicitar permiso para las notificaciones: %@";

/* ログ：起動時に通知が許可されなかった */
"Notifications aren't allowed. Allow atme under Notifications in System Settings" = "Las notificaciones no están permitidas. Permite atme en Notificaciones, en Ajustes del Sistema";

/* ログ：.app の外の CLI では通知しない */
"Not sending notifications because atme was run outside atme.app" = "No se envían notificaciones porque atme se ejecutó fuera de atme.app";

/* ログ：通知が許可されていない */
"Notifications aren't allowed. Open atme.app to allow them" = "Las notificaciones no están permitidas. Abre atme.app para permitirlas";

/* ログ：通知の設定を読めない */
"Not sending notifications because the notification settings couldn't be read" = "No se envían notificaciones porque no se pudieron leer los ajustes de notificación";

/* ログ：通知の登録に失敗 */
"Couldn't send a notification: %@" = "No se pudo enviar una notificación: %@";

/* ログ：通知の登録が返ってこない */
"No response to the notification request" = "No hubo respuesta a la solicitud de notificación";

/* CLI：atme list でキャッシュが無い */
"No cache. Run atme fetch" = "Sin caché. Ejecuta atme fetch";

/* CLI：atme fetch のワークスペースごとの結果。%1$@ はワークスペース名、%2$@ は一覧の件数、%3$@ は新着の件数 */
"%1$@: %2$@ total, %3$@ new" = "%1$@: %2$@ en total, %3$@ nuevos";
