/* キーは英語の文言そのもの（src/l10n.rs）。訳が無いときは英語のまま出る */

/* メニュー：アプリを終了する */
"Quit" = "Quitter";

/* メニュー：Sparkle で新しい版を確かめる */
"Check for Updates…" = "Rechercher les mises à jour…";

/* メニュー：キャッシュのファイルが無いとき */
"No cache" = "Aucun cache";

/* メニュー：1 度も取得に成功していないとき */
"Not fetched yet" = "Pas encore récupéré";

/* メニュー：最後に取得できた時刻。%@ は「10/28 19:05」の形 */
"Fetched %@" = "Récupéré : %@";

/* メニュー：取得全体の失敗。%@ はエラーの内容 */
"Fetch failed: %@" = "Échec de la récupération : %@";

/* メニュー：ワークスペースごとの取得の失敗。%1$@ はワークスペース名、%2$@ はエラーの内容 */
"Fetch failed: %1$@ (%2$@)" = "Échec de la récupération : %1$@ (%2$@)";

/* メニュー：ログイン時の起動の切り替えの失敗。%@ は macOS のエラーの説明 */
"Couldn't change Open at Login (%@)" = "Impossible de modifier « Ouvrir à l’ouverture de session » (%@)";

/* メニュー：ワークスペースに未読が無いとき */
"None" = "Aucun";

/* メニュー：一覧をすべて既読として外す */
"Mark All as Read" = "Tout marquer comme lu";

/* メニュー：すぐに取得する */
"Fetch Now" = "Récupérer maintenant";

/* メニュー：前回の取得から間が無く、まだ押せないとき。%@ は残りの秒数 */
"Fetch Now (in %@s)" = "Récupérer maintenant (dans %@ s)";

/* メニュー：取得の順番を待っているとき */
"Waiting to Fetch" = "En attente de récupération";

/* メニュー：取得しているとき */
"Fetching…" = "Récupération…";

/* メニュー：ログイン時に atme を起動する */
"Open at Login" = "Ouvrir à l’ouverture de session";

/* メニュー：ログイン時の起動に、システム設定での承認が要るとき */
"Open at Login (needs approval in System Settings)" = "Ouvrir à l’ouverture de session (approbation requise dans Réglages Système)";

/* 通知：個別に出さなかった残りの件数。%@ は件数 */
"And %@ more" = "Et %@ de plus";

/* メニューと通知：グループ DM の場所の名前 */
"Group DM" = "Message direct de groupe";

/* メニューと通知：本文が空のメッセージ */
"(no text)" = "(aucun texte)";

/* ファイルを読めなかった。%@ はファイルのパス */
"Couldn't read %@" = "Impossible de lire %@";

/* 設定や状態のファイルの中身が読み取れない。%@ はファイルのパス */
"The contents of %@ are invalid" = "Le contenu de %@ n’est pas valide";

/* 設定ファイルで同じ name が 2 回ある。%@ は name */
"Workspace name %@ is duplicated" = "Le nom d’espace de travail %@ est en double";

/* 環境変数 HOME が無い */
"HOME is not set" = "HOME n’est pas défini";

/* Keychain に token が無いなど。%3$@ は security コマンドの出力 */
"Couldn't read service=%1$@ account=%2$@ from the Keychain: %3$@" = "Impossible de lire service=%1$@ account=%2$@ dans le trousseau : %3$@";

/* Keychain の値が文字列として読めない */
"The value of account=%@ in the Keychain isn't UTF-8" = "La valeur de account=%@ dans le trousseau n’est pas en UTF-8";

/* ログ：チャンネルの既読の取得に失敗。%1$@ はチャンネル ID */
"Couldn't read the read state of %1$@: %2$@" = "Impossible de lire l’état de lecture de %1$@ : %2$@";

/* ログ：スレッドの既読の取得に失敗。%1$@ はチャンネル ID、%2$@ はスレッドの ts */
"Couldn't read the read state of thread %2$@ in %1$@: %3$@" = "Impossible de lire l’état de lecture du fil %2$@ dans %1$@ : %3$@";

/* HTTP の準備に失敗 */
"Couldn't create the HTTP client" = "Impossible de créer le client HTTP";

/* Slack の応答にスレッドの親が無い */
"conversations.replies didn't return the thread parent" = "conversations.replies n’a pas renvoyé le message parent du fil";

/* Slack の API に接続できない。%@ は API の名前 */
"Couldn't call %@" = "Impossible d’appeler %@";

/* Slack の API が HTTP のエラーを返した */
"%1$@ returned HTTP %2$@" = "%1$@ a renvoyé HTTP %2$@";

/* Slack の応答を受け取れない */
"Couldn't read the response of %@" = "Impossible de lire la réponse de %@";

/* Slack の応答の形が想定と違う */
"Couldn't parse the response of %@" = "Impossible d’analyser la réponse de %@";

/* Slack の API がエラーを返した。%2$@ は Slack のエラーコード（訳さない） */
"%1$@ failed: %2$@" = "Échec de %1$@ : %2$@";

/* 状態のファイルの保存先が無い */
"No directory to save to" = "Aucun dossier où enregistrer";

/* ディレクトリを作れない */
"Couldn't create %@" = "Impossible de créer %@";

/* ファイルの権限を変えられない */
"Couldn't set the permissions of %@" = "Impossible de définir les autorisations de %@";

/* ファイルを開けない */
"Couldn't open %@" = "Impossible d’ouvrir %@";

/* ファイルに書けない */
"Couldn't write to %@" = "Impossible d’écrire dans %@";

/* 書いたファイルで置き換えられない */
"Couldn't replace %@" = "Impossible de remplacer %@";

/* CLI：atme fetch で失敗があった */
"Some workspaces failed to fetch" = "La récupération a échoué pour certains espaces de travail";

/* ログ：users.info の失敗。%1$@ はワークスペース、%2$@ はユーザー ID */
"%1$@: couldn't look up the display name of %2$@: %3$@" = "%1$@ : impossible de trouver le nom d’affichage de %2$@ : %3$@";

/* ログ：自動アップデートの準備に失敗 */
"Couldn't load Sparkle.framework" = "Impossible de charger Sparkle.framework";

/* .app の外から引数なしで起動した */
"Can't stay in the menu bar because atme was run outside atme.app" = "Impossible de rester dans la barre des menus, car atme a été lancé en dehors d’atme.app";

/* 内部のエラー */
"Not running on the main thread" = "Ne s’exécute pas sur le fil d’exécution principal";

/* ログ：通知の許可の問い合わせに失敗 */
"Couldn't ask for notification permission: %@" = "Impossible de demander l’autorisation des notifications : %@";

/* ログ：起動時に通知が許可されなかった */
"Notifications aren't allowed. Allow atme under Notifications in System Settings" = "Les notifications ne sont pas autorisées. Autorisez atme dans Notifications, dans Réglages Système";

/* ログ：.app の外の CLI では通知しない */
"Not sending notifications because atme was run outside atme.app" = "Aucune notification envoyée, car atme a été lancé en dehors d’atme.app";

/* ログ：通知が許可されていない */
"Notifications aren't allowed. Open atme.app to allow them" = "Les notifications ne sont pas autorisées. Ouvrez atme.app pour les autoriser";

/* ログ：通知の設定を読めない */
"Not sending notifications because the notification settings couldn't be read" = "Aucune notification envoyée, car les réglages de notification n’ont pas pu être lus";

/* ログ：通知の登録に失敗 */
"Couldn't send a notification: %@" = "Impossible d’envoyer une notification : %@";

/* ログ：通知の登録が返ってこない */
"No response to the notification request" = "Aucune réponse à la demande de notification";

/* CLI：atme list でキャッシュが無い */
"No cache. Run atme fetch" = "Aucun cache. Exécutez atme fetch";

/* CLI：atme fetch のワークスペースごとの結果。%1$@ はワークスペース名、%2$@ は一覧の件数、%3$@ は新着の件数 */
"%1$@: %2$@ total, %3$@ new" = "%1$@ : %2$@ au total, %3$@ nouveaux";

/* token を Keychain に保存できない */
"Couldn't save service=%1$@ account=%2$@ to the Keychain" = "Impossible d’enregistrer service=%1$@ account=%2$@ dans le trousseau";

/* token を Keychain から消せない */
"Couldn't delete service=%1$@ account=%2$@ from the Keychain" = "Impossible de supprimer service=%1$@ account=%2$@ du trousseau";

/* 同じワークスペースを 2 回足そうとした。%@ はワークスペース名 */
"%@ has already been added" = "%@ a déjà été ajouté";

/* 入れた値が user token ではない */
"Paste a User OAuth Token that starts with xoxp-" = "Collez un User OAuth Token commençant par xoxp-";

/* Slack の応答にワークスペースの URL が無い */
"auth.test didn't return the workspace URL" = "auth.test n’a pas renvoyé l’URL de l’espace de travail";

/* メニュー：ワークスペースの追加・削除のウインドウを開く */
"Workspaces…" = "Espaces de travail…";

/* ウインドウの題 */
"Workspaces" = "Espaces de travail";

/* ウインドウ：ワークスペースを外すボタン */
"Remove" = "Supprimer";

/* ウインドウ：token を確かめて足すボタン */
"Add" = "Ajouter";

/* ウインドウ：token の入力欄の見出し（Slack の画面の表記に合わせて訳さない） */
"User OAuth Token" = "User OAuth Token";

/* ウインドウ：token を確かめているとき */
"Checking…" = "Vérification…";

/* ウインドウ：追加できたとき。%@ はワークスペース名 */
"Added %@" = "%@ a été ajouté";

/* ウインドウ：ワークスペースが 1 つも無いとき */
"No workspaces yet. Paste a token to add one." = "Aucun espace de travail. Collez un token pour en ajouter un.";

/* ウインドウ：追加済みのワークスペースの一覧の見出し */
"Added Workspaces" = "Espaces de travail ajoutés";

/* ウインドウ：token を入れて足す欄の見出し */
"Add a Workspace" = "Ajouter un espace de travail";

/* メニュー：ワークスペースが 1 つも無いとき。「ワークスペース…」はメニューの項目名に合わせる */
"No workspaces. Add one from Workspaces…" = "Aucun espace de travail. Ajoutez-en un depuis « Espaces de travail… »";

/* 設定ファイルの workspace が [[workspace]] の表になっていない */
"workspace must be written as [[workspace]]" = "workspace doit être écrit sous la forme [[workspace]]";

/* 削除の確認の題。%@ はワークスペース名 */
"Remove %@?" = "Supprimer %@ ?";

/* 削除の確認の説明 */
"The token is also deleted from the Keychain. You can add the workspace again by pasting the same token." = "Le token est aussi supprimé du trousseau. Vous pourrez rajouter l’espace de travail en collant le même token.";

/* 削除の確認：何もしないボタン */
"Cancel" = "Annuler";
