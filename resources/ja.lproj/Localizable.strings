/* キーは英語の文言そのもの（src/l10n.rs）。訳が無いときは英語のまま出る */

/* メニュー：アプリを終了する */
"Quit" = "終了";

/* メニュー：Sparkle で新しい版を確かめる */
"Check for Updates…" = "アップデートを確認…";

/* メニュー：キャッシュのファイルが無いとき */
"No cache" = "キャッシュがありません";

/* メニュー：ワークスペースが 1 つも分からず、表示するものも無いとき */
"No mentions or DMs" = "メンションと DM はありません";

/* メニュー：1 度も取得に成功していないとき */
"Not fetched yet" = "まだ取得できていません";

/* メニュー：最後に取得できた時刻。%@ は「10/28 19:05」の形 */
"Fetched %@" = "取得 %@";

/* メニュー：取得全体の失敗。%@ はエラーの内容 */
"Fetch failed: %@" = "取得に失敗：%@";

/* メニュー：ワークスペースごとの取得の失敗。%1$@ はワークスペース名、%2$@ はエラーの内容 */
"Fetch failed: %1$@ (%2$@)" = "取得に失敗：%1$@（%2$@）";

/* メニュー：ログイン時の起動の切り替えの失敗。%@ は macOS のエラーの説明 */
"Couldn't change Open at Login (%@)" = "ログイン時の起動を切り替えられませんでした（%@）";

/* メニュー：ワークスペースに未読が無いとき */
"None" = "なし";

/* メニュー：一覧をすべて既読として外す */
"Mark All as Read" = "すべて既読にする";

/* メニュー：すぐに取得する */
"Fetch Now" = "今すぐ取得";

/* メニュー：前回の取得から間が無く、まだ押せないとき。%@ は残りの秒数 */
"Fetch Now (in %@s)" = "今すぐ取得（あと %@ 秒）";

/* メニュー：取得の順番を待っているとき */
"Waiting to Fetch" = "取得待機中";

/* メニュー：取得しているとき */
"Fetching…" = "取得中…";

/* メニュー：ログイン時に atme を起動する */
"Open at Login" = "ログイン時に起動";

/* メニュー：ログイン時の起動に、システム設定での承認が要るとき */
"Open at Login (needs approval in System Settings)" = "ログイン時に起動（システム設定で承認が必要）";

/* 通知：個別に出さなかった残りの件数。%@ は件数 */
"And %@ more" = "ほか %@ 件の新着があります";

/* メニューと通知：グループ DM の場所の名前 */
"Group DM" = "グループ DM";

/* メニューと通知：本文が空のメッセージ */
"(no text)" = "（本文なし）";

/* ファイルを読めなかった。%@ はファイルのパス */
"Couldn't read %@" = "%@ を読めませんでした";

/* 設定や状態のファイルの中身が読み取れない。%@ はファイルのパス */
"The contents of %@ are invalid" = "%@ の内容が正しくありません";

/* 設定ファイルにワークスペースが無い */
"No [[workspace]] is configured" = "[[workspace]] が 1 つもありません";

/* 設定ファイルで同じ name が 2 回ある。%@ は name */
"Workspace name %@ is duplicated" = "ワークスペース名 %@ が重複しています";

/* 環境変数 HOME が無い */
"HOME is not set" = "HOME が設定されていません";

/* Keychain を読む security コマンドを動かせない */
"Couldn't run the security command" = "security コマンドを実行できませんでした";

/* Keychain に token が無いなど。%3$@ は security コマンドの出力 */
"Couldn't read service=%1$@ account=%2$@ from the Keychain: %3$@" = "Keychain から service=%1$@ account=%2$@ を読めませんでした: %3$@";

/* Keychain の値が文字列として読めない */
"The value of account=%@ in the Keychain isn't UTF-8" = "Keychain の account=%@ の値が UTF-8 ではありません";

/* ログ：チャンネルの既読の取得に失敗。%1$@ はチャンネル ID */
"Couldn't read the read state of %1$@: %2$@" = "%1$@ の既読を読めませんでした: %2$@";

/* ログ：スレッドの既読の取得に失敗。%1$@ はチャンネル ID、%2$@ はスレッドの ts */
"Couldn't read the read state of thread %2$@ in %1$@: %3$@" = "%1$@ のスレッド %2$@ の既読を読めませんでした: %3$@";

/* HTTP の準備に失敗 */
"Couldn't create the HTTP client" = "HTTP クライアントを作れませんでした";

/* Slack の応答にスレッドの親が無い */
"conversations.replies didn't return the thread parent" = "conversations.replies がスレッドの親を返しませんでした";

/* Slack の API に接続できない。%@ は API の名前 */
"Couldn't call %@" = "%@ を呼び出せませんでした";

/* Slack の API が HTTP のエラーを返した */
"%1$@ returned HTTP %2$@" = "%1$@ が HTTP %2$@ を返しました";

/* Slack の応答を受け取れない */
"Couldn't read the response of %@" = "%@ の応答を読めませんでした";

/* Slack の応答の形が想定と違う */
"Couldn't parse the response of %@" = "%@ の応答を解釈できませんでした";

/* Slack の API がエラーを返した。%2$@ は Slack のエラーコード（訳さない） */
"%1$@ failed: %2$@" = "%1$@ が失敗しました: %2$@";

/* 状態のファイルの保存先が無い */
"No directory to save to" = "保存先のディレクトリがありません";

/* ディレクトリを作れない */
"Couldn't create %@" = "%@ を作れませんでした";

/* ファイルの権限を変えられない */
"Couldn't set the permissions of %@" = "%@ の権限を設定できませんでした";

/* ファイルを開けない */
"Couldn't open %@" = "%@ を開けませんでした";

/* ファイルに書けない */
"Couldn't write to %@" = "%@ に書けませんでした";

/* 書いたファイルで置き換えられない */
"Couldn't replace %@" = "%@ に置き換えられませんでした";

/* CLI：atme fetch で失敗があった */
"Some workspaces failed to fetch" = "取得に失敗したワークスペースがあります";

/* ログ：users.info の失敗。%1$@ はワークスペース、%2$@ はユーザー ID */
"%1$@: couldn't look up the display name of %2$@: %3$@" = "%1$@: %2$@ の表示名を引けませんでした: %3$@";

/* ログ：自動アップデートの準備に失敗 */
"Couldn't load Sparkle.framework" = "Sparkle.framework を読み込めませんでした";

/* .app の外から引数なしで起動した */
"Can't stay in the menu bar because atme was run outside atme.app" = "atme.app の外から実行したため、常駐できません";

/* 内部のエラー */
"Not running on the main thread" = "メインスレッドで動いていません";

/* ログ：通知の許可の問い合わせに失敗 */
"Couldn't ask for notification permission: %@" = "通知の許可を求められませんでした: %@";

/* ログ：起動時に通知が許可されなかった */
"Notifications aren't allowed. Allow atme under Notifications in System Settings" = "通知が許可されていません。システム設定の「通知」で atme を許可してください";

/* ログ：.app の外の CLI では通知しない */
"Not sending notifications because atme was run outside atme.app" = "atme.app の外から実行したため、通知を出しません";

/* ログ：通知が許可されていない */
"Notifications aren't allowed. Open atme.app to allow them" = "通知が許可されていません。atme.app を open して許可してください";

/* ログ：通知の設定を読めない */
"Not sending notifications because the notification settings couldn't be read" = "通知の設定を読めなかったため、通知を出しません";

/* ログ：通知の登録に失敗 */
"Couldn't send a notification: %@" = "通知を出せませんでした: %@";

/* ログ：通知の登録が返ってこない */
"No response to the notification request" = "通知の登録の応答がありませんでした";

/* CLI：atme list でキャッシュが無い */
"No cache. Run atme fetch" = "キャッシュがありません。atme fetch を実行してください";
