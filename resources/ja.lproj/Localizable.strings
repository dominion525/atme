/* キーは英語の文言そのもの（src/l10n.rs）。訳が無いときは英語のまま出る */

/* メニュー：アプリを終了する */
"Quit" = "終了";

/* メニュー：Sparkle で新しい版を確かめる */
"Check for Updates…" = "アップデートを確認…";

/* メニュー：キャッシュのファイルが無いとき */
"No cache" = "キャッシュがありません";

/* メニュー：ワークスペースが 1 つも分からず、表示するものも無いとき */
"No mentions or DMs" = "メンションと DM はありません";

/* メニュー：1 度も取得に成功していないとき */
"Not fetched yet" = "まだ取得できていません";

/* メニュー：最後に取得できた時刻。%@ は「10/28 19:05」の形 */
"Fetched %@" = "取得 %@";

/* メニュー：取得全体の失敗。%@ はエラーの内容 */
"Fetch failed: %@" = "取得に失敗：%@";

/* メニュー：ワークスペースごとの取得の失敗。%1$@ はワークスペース名、%2$@ はエラーの内容 */
"Fetch failed: %1$@ (%2$@)" = "取得に失敗：%1$@（%2$@）";

/* メニュー：ログイン時の起動の切り替えの失敗。%@ は macOS のエラーの説明 */
"Couldn't change Open at Login (%@)" = "ログイン時の起動を切り替えられませんでした（%@）";

/* メニュー：ワークスペースに未読が無いとき */
"None" = "なし";

/* メニュー：一覧をすべて既読として外す */
"Mark All as Read" = "すべて既読にする";

/* メニュー：すぐに取得する */
"Fetch Now" = "今すぐ取得";

/* メニュー：前回の取得から間が無く、まだ押せないとき。%@ は残りの秒数 */
"Fetch Now (in %@s)" = "今すぐ取得（あと %@ 秒）";

/* メニュー：取得の順番を待っているとき */
"Waiting to Fetch" = "取得待機中";

/* メニュー：取得しているとき */
"Fetching…" = "取得中…";

/* メニュー：ログイン時に atme を起動する */
"Open at Login" = "ログイン時に起動";

/* メニュー：ログイン時の起動に、システム設定での承認が要るとき */
"Open at Login (needs approval in System Settings)" = "ログイン時に起動（システム設定で承認が必要）";

/* 通知：個別に出さなかった残りの件数。%@ は件数 */
"And %@ more" = "ほか %@ 件の新着があります";

/* メニューと通知：グループ DM の場所の名前 */
"Group DM" = "グループ DM";

/* メニューと通知：本文が空のメッセージ */
"(no text)" = "（本文なし）";
