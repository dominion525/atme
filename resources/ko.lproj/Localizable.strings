/* キーは英語の文言そのもの（src/l10n.rs）。訳が無いときは英語のまま出る */

/* メニュー：アプリを終了する */
"Quit" = "종료";

/* メニュー：Sparkle で新しい版を確かめる */
"Check for Updates…" = "업데이트 확인…";

/* メニュー：キャッシュのファイルが無いとき */
"No cache" = "캐시 없음";

/* メニュー：1 度も取得に成功していないとき */
"Not fetched yet" = "아직 가져오지 않음";

/* メニュー：最後に取得できた時刻。%@ は「10/28 19:05」の形 */
"Fetched %@" = "가져온 시각 %@";

/* メニュー：取得全体の失敗。%@ はエラーの内容 */
"Fetch failed: %@" = "가져오기 실패: %@";

/* メニュー：ワークスペースごとの取得の失敗。%1$@ はワークスペース名、%2$@ はエラーの内容 */
"Fetch failed: %1$@ (%2$@)" = "가져오기 실패: %1$@ (%2$@)";

/* メニュー：ログイン時の起動の切り替えの失敗。%@ は macOS のエラーの説明 */
"Couldn't change Open at Login (%@)" = "'로그인 시 열기'를 변경할 수 없음 (%@)";

/* メニュー：ワークスペースに未読が無いとき */
"None" = "없음";

/* メニュー：一覧をすべて既読として外す */
"Mark All as Read" = "모두 읽음으로 표시";

/* メニュー：すぐに取得する */
"Fetch Now" = "지금 가져오기";

/* メニュー：前回の取得から間が無く、まだ押せないとき。%@ は残りの秒数 */
"Fetch Now (in %@s)" = "지금 가져오기 (%@초 후)";

/* メニュー：取得の順番を待っているとき */
"Waiting to Fetch" = "가져오기 대기 중";

/* メニュー：取得しているとき */
"Fetching…" = "가져오는 중…";

/* メニュー：ログイン時に atme を起動する */
"Open at Login" = "로그인 시 열기";

/* メニュー：ログイン時の起動に、システム設定での承認が要るとき */
"Open at Login (needs approval in System Settings)" = "로그인 시 열기 (시스템 설정에서 승인 필요)";

/* 通知：個別に出さなかった残りの件数。%@ は件数 */
"And %@ more" = "외 %@개의 읽지 않은 메시지";

/* メニューと通知：グループ DM の場所の名前 */
"Group DM" = "그룹 DM";

/* メニューと通知：本文が空のメッセージ */
"(no text)" = "(본문 없음)";

/* ファイルを読めなかった。%@ はファイルのパス */
"Couldn't read %@" = "%@을(를) 읽을 수 없음";

/* 設定や状態のファイルの中身が読み取れない。%@ はファイルのパス */
"The contents of %@ are invalid" = "%@의 내용이 올바르지 않음";

/* 設定ファイルで同じ name が 2 回ある。%@ は name */
"Workspace name %@ is duplicated" = "워크스페이스 이름 %@이(가) 중복됨";

/* 環境変数 HOME が無い */
"HOME is not set" = "HOME이 설정되지 않음";

/* Keychain に token が無いなど。%3$@ は security コマンドの出力 */
"Couldn't read service=%1$@ account=%2$@ from the Keychain: %3$@" = "키체인에서 service=%1$@ account=%2$@을(를) 읽을 수 없음: %3$@";

/* Keychain の値が文字列として読めない */
"The value of account=%@ in the Keychain isn't UTF-8" = "키체인의 account=%@ 값이 UTF-8이 아님";

/* ログ：チャンネルの既読の取得に失敗。%1$@ はチャンネル ID */
"Couldn't read the read state of %1$@: %2$@" = "%1$@의 읽음 상태를 읽을 수 없음: %2$@";

/* ログ：スレッドの既読の取得に失敗。%1$@ はチャンネル ID、%2$@ はスレッドの ts */
"Couldn't read the read state of thread %2$@ in %1$@: %3$@" = "%1$@의 스레드 %2$@의 읽음 상태를 읽을 수 없음: %3$@";

/* HTTP の準備に失敗 */
"Couldn't create the HTTP client" = "HTTP 클라이언트를 만들 수 없음";

/* Slack の応答にスレッドの親が無い */
"conversations.replies didn't return the thread parent" = "conversations.replies가 스레드의 상위 메시지를 반환하지 않음";

/* Slack の API に接続できない。%@ は API の名前 */
"Couldn't call %@" = "%@을(를) 호출할 수 없음";

/* Slack の API が HTTP のエラーを返した */
"%1$@ returned HTTP %2$@" = "%1$@이(가) HTTP %2$@을(를) 반환함";

/* Slack の応答を受け取れない */
"Couldn't read the response of %@" = "%@의 응답을 읽을 수 없음";

/* Slack の応答の形が想定と違う */
"Couldn't parse the response of %@" = "%@의 응답을 해석할 수 없음";

/* Slack の API がエラーを返した。%2$@ は Slack のエラーコード（訳さない） */
"%1$@ failed: %2$@" = "%1$@ 실패: %2$@";

/* 状態のファイルの保存先が無い */
"No directory to save to" = "저장할 디렉터리가 없음";

/* ディレクトリを作れない */
"Couldn't create %@" = "%@을(를) 만들 수 없음";

/* ファイルの権限を変えられない */
"Couldn't set the permissions of %@" = "%@의 권한을 설정할 수 없음";

/* ファイルを開けない */
"Couldn't open %@" = "%@을(를) 열 수 없음";

/* ファイルに書けない */
"Couldn't write to %@" = "%@에 쓸 수 없음";

/* 書いたファイルで置き換えられない */
"Couldn't replace %@" = "%@을(를) 교체할 수 없음";

/* CLI：atme fetch で失敗があった */
"Some workspaces failed to fetch" = "가져오기에 실패한 워크스페이스가 있음";

/* ログ：users.info の失敗。%1$@ はワークスペース、%2$@ はユーザー ID */
"%1$@: couldn't look up the display name of %2$@: %3$@" = "%1$@: %2$@의 표시 이름을 조회할 수 없음: %3$@";

/* ログ：自動アップデートの準備に失敗 */
"Couldn't load Sparkle.framework" = "Sparkle.framework를 불러올 수 없음";

/* .app の外から引数なしで起動した */
"Can't stay in the menu bar because atme was run outside atme.app" = "atme.app 밖에서 실행했기 때문에 메뉴 막대에 상주할 수 없음";

/* 内部のエラー */
"Not running on the main thread" = "메인 스레드에서 실행되고 있지 않음";

/* ログ：通知の許可の問い合わせに失敗 */
"Couldn't ask for notification permission: %@" = "알림 권한을 요청할 수 없음: %@";

/* ログ：起動時に通知が許可されなかった */
"Notifications aren't allowed. Allow atme under Notifications in System Settings" = "알림이 허용되지 않았습니다. 시스템 설정의 '알림'에서 atme을 허용하십시오";

/* ログ：.app の外の CLI では通知しない */
"Not sending notifications because atme was run outside atme.app" = "atme.app 밖에서 실행했기 때문에 알림을 보내지 않음";

/* ログ：通知が許可されていない */
"Notifications aren't allowed. Open atme.app to allow them" = "알림이 허용되지 않았습니다. atme.app을 열어 허용하십시오";

/* ログ：通知の設定を読めない */
"Not sending notifications because the notification settings couldn't be read" = "알림 설정을 읽을 수 없어 알림을 보내지 않음";

/* ログ：通知の登録に失敗 */
"Couldn't send a notification: %@" = "알림을 보낼 수 없음: %@";

/* ログ：通知の登録が返ってこない */
"No response to the notification request" = "알림 요청에 응답이 없음";

/* CLI：atme list でキャッシュが無い */
"No cache. Run atme fetch" = "캐시가 없습니다. atme fetch를 실행하십시오";

/* CLI：atme fetch のワークスペースごとの結果。%1$@ はワークスペース名、%2$@ は一覧の件数、%3$@ は新着の件数 */
"%1$@: %2$@ total, %3$@ new" = "%1$@: 전체 %2$@개, 새 메시지 %3$@개";

/* token を Keychain に保存できない */
"Couldn't save service=%1$@ account=%2$@ to the Keychain" = "키체인에 service=%1$@ account=%2$@을(를) 저장할 수 없음";

/* token を Keychain から消せない */
"Couldn't delete service=%1$@ account=%2$@ from the Keychain" = "키체인에서 service=%1$@ account=%2$@을(를) 삭제할 수 없음";

/* 同じワークスペースを 2 回足そうとした。%@ はワークスペース名 */
"%@ has already been added" = "%@은(는) 이미 추가됨";

/* 入れた値が user token ではない */
"Paste a User OAuth Token that starts with xoxp-" = "xoxp-로 시작하는 User OAuth Token을 붙여 넣으십시오";

/* Slack の応答にワークスペースの URL が無い */
"auth.test didn't return the workspace URL" = "auth.test가 워크스페이스 URL을 반환하지 않음";

/* メニュー：ワークスペースの追加・削除のウインドウを開く */
"Workspaces…" = "워크스페이스…";

/* ウインドウの題 */
"Workspaces" = "워크스페이스";

/* ウインドウ：ワークスペースを外すボタン */
"Remove" = "제거";

/* ウインドウ：token を確かめて足すボタン */
"Add" = "추가";

/* ウインドウ：token を確かめているとき */
"Checking…" = "확인 중…";

/* ウインドウ：追加できたとき。%@ はワークスペース名 */
"Added %@" = "%@을(를) 추가함";

/* メニュー：ワークスペースが 1 つも無いとき。「ワークスペース…」はメニューの項目名に合わせる */
"No workspaces. Add one from Workspaces…" = "워크스페이스가 없습니다. '워크스페이스…'에서 추가하십시오";

/* 設定ファイルの workspace が [[workspace]] の表になっていない */
"workspace must be written as [[workspace]]" = "workspace는 [[workspace]] 형식으로 작성해야 합니다";

/* 削除の確認の題。%@ はワークスペース名 */
"Remove %@?" = "%@을(를) 제거하시겠습니까?";

/* 削除の確認の説明 */
"The token is also deleted from the Keychain. You can add the workspace again by pasting the same token." = "token도 키체인에서 삭제됩니다. 같은 token을 붙여 넣으면 다시 추가할 수 있습니다.";

/* 削除の確認：何もしないボタン */
"Cancel" = "취소";

/* ウインドウ：manifest を入れて Slack App を作る画面をブラウザで開くボタン */
"Create Slack App…" = "Slack App 만들기…";

/* ウインドウ：追加済みのワークスペースが 1 つも無いとき */
"No workspaces" = "워크스페이스 없음";

/* ウインドウ：手順 1。右に「Slack App を作る…」のボタンが並ぶ */
"1. Create a Slack App for each workspace" = "1. 워크스페이스마다 Slack App 만들기";

/* ウインドウ：手順 2（Install to Workspace は Slack の画面の表記のまま） */
"2. Click Install to Workspace and copy the token" = "2. Install to Workspace를 누르고 token 복사하기";

/* ウインドウ：手順 3。下に token の入力欄と「追加」が並ぶ */
"3. Paste the copied token and add it" = "3. 복사한 token을 붙여 넣고 추가하기";
