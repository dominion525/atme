/* キーは英語の文言そのもの（src/l10n.rs）。訳が無いときは英語のまま出る */

/* メニュー：アプリを終了する */
"Quit" = "Encerrar";

/* メニュー：Sparkle で新しい版を確かめる */
"Check for Updates…" = "Buscar Atualizações…";

/* メニュー：キャッシュのファイルが無いとき */
"No cache" = "Sem cache";

/* メニュー：1 度も取得に成功していないとき */
"Not fetched yet" = "Ainda não buscado";

/* メニュー：最後に取得できた時刻。%@ は「10/28 19:05」の形 */
"Fetched %@" = "Buscado: %@";

/* メニュー：取得全体の失敗。%@ はエラーの内容 */
"Fetch failed: %@" = "Falha ao buscar: %@";

/* メニュー：ワークスペースごとの取得の失敗。%1$@ はワークスペース名、%2$@ はエラーの内容 */
"Fetch failed: %1$@ (%2$@)" = "Falha ao buscar: %1$@ (%2$@)";

/* メニュー：ログイン時の起動の切り替えの失敗。%@ は macOS のエラーの説明 */
"Couldn't change Open at Login (%@)" = "Não foi possível alterar “Abrir ao Iniciar Sessão” (%@)";

/* メニュー：ワークスペースに未読が無いとき */
"None" = "Nenhuma";

/* メニュー：一覧をすべて既読として外す */
"Mark All as Read" = "Marcar Tudo como Lido";

/* メニュー：すぐに取得する */
"Fetch Now" = "Buscar Agora";

/* メニュー：前回の取得から間が無く、まだ押せないとき。%@ は残りの秒数 */
"Fetch Now (in %@s)" = "Buscar Agora (em %@ s)";

/* メニュー：取得の順番を待っているとき */
"Waiting to Fetch" = "Aguardando para Buscar";

/* メニュー：取得しているとき */
"Fetching…" = "Buscando…";

/* メニュー：ログイン時に atme を起動する */
"Open at Login" = "Abrir ao Iniciar Sessão";

/* メニュー：ログイン時の起動に、システム設定での承認が要るとき */
"Open at Login (needs approval in System Settings)" = "Abrir ao Iniciar Sessão (requer aprovação nos Ajustes do Sistema)";

/* 通知：個別に出さなかった残りの件数。%@ は件数 */
"And %@ more" = "E mais %@";

/* メニューと通知：グループ DM の場所の名前 */
"Group DM" = "Mensagem direta em grupo";

/* メニューと通知：本文が空のメッセージ */
"(no text)" = "(sem texto)";

/* ファイルを読めなかった。%@ はファイルのパス */
"Couldn't read %@" = "Não foi possível ler %@";

/* 設定や状態のファイルの中身が読み取れない。%@ はファイルのパス */
"The contents of %@ are invalid" = "O conteúdo de %@ é inválido";

/* 設定ファイルで同じ name が 2 回ある。%@ は name */
"Workspace name %@ is duplicated" = "O nome do workspace %@ está duplicado";

/* 環境変数 HOME が無い */
"HOME is not set" = "HOME não está definido";

/* Keychain に token が無いなど。%3$@ は security コマンドの出力 */
"Couldn't read service=%1$@ account=%2$@ from the Keychain: %3$@" = "Não foi possível ler service=%1$@ account=%2$@ das Chaves: %3$@";

/* Keychain の値が文字列として読めない */
"The value of account=%@ in the Keychain isn't UTF-8" = "O valor de account=%@ nas Chaves não está em UTF-8";

/* ログ：チャンネルの既読の取得に失敗。%1$@ はチャンネル ID */
"Couldn't read the read state of %1$@: %2$@" = "Não foi possível ler o estado de leitura de %1$@: %2$@";

/* ログ：スレッドの既読の取得に失敗。%1$@ はチャンネル ID、%2$@ はスレッドの ts */
"Couldn't read the read state of thread %2$@ in %1$@: %3$@" = "Não foi possível ler o estado de leitura da conversa %2$@ em %1$@: %3$@";

/* HTTP の準備に失敗 */
"Couldn't create the HTTP client" = "Não foi possível criar o cliente HTTP";

/* Slack の応答にスレッドの親が無い */
"conversations.replies didn't return the thread parent" = "conversations.replies não retornou a mensagem principal da conversa";

/* Slack の API に接続できない。%@ は API の名前 */
"Couldn't call %@" = "Não foi possível chamar %@";

/* Slack の API が HTTP のエラーを返した */
"%1$@ returned HTTP %2$@" = "%1$@ retornou HTTP %2$@";

/* Slack の応答を受け取れない */
"Couldn't read the response of %@" = "Não foi possível ler a resposta de %@";

/* Slack の応答の形が想定と違う */
"Couldn't parse the response of %@" = "Não foi possível interpretar a resposta de %@";

/* Slack の API がエラーを返した。%2$@ は Slack のエラーコード（訳さない） */
"%1$@ failed: %2$@" = "%1$@ falhou: %2$@";

/* 状態のファイルの保存先が無い */
"No directory to save to" = "Nenhuma pasta para salvar";

/* ディレクトリを作れない */
"Couldn't create %@" = "Não foi possível criar %@";

/* ファイルの権限を変えられない */
"Couldn't set the permissions of %@" = "Não foi possível definir as permissões de %@";

/* ファイルを開けない */
"Couldn't open %@" = "Não foi possível abrir %@";

/* ファイルに書けない */
"Couldn't write to %@" = "Não foi possível gravar em %@";

/* 書いたファイルで置き換えられない */
"Couldn't replace %@" = "Não foi possível substituir %@";

/* CLI：atme fetch で失敗があった */
"Some workspaces failed to fetch" = "A busca falhou em alguns workspaces";

/* ログ：users.info の失敗。%1$@ はワークスペース、%2$@ はユーザー ID */
"%1$@: couldn't look up the display name of %2$@: %3$@" = "%1$@: não foi possível obter o nome de exibição de %2$@: %3$@";

/* ログ：自動アップデートの準備に失敗 */
"Couldn't load Sparkle.framework" = "Não foi possível carregar Sparkle.framework";

/* .app の外から引数なしで起動した */
"Can't stay in the menu bar because atme was run outside atme.app" = "Não é possível ficar na barra de menus porque o atme foi executado fora do atme.app";

/* 内部のエラー */
"Not running on the main thread" = "Não está em execução no thread principal";

/* ログ：通知の許可の問い合わせに失敗 */
"Couldn't ask for notification permission: %@" = "Não foi possível solicitar permissão para notificações: %@";

/* ログ：起動時に通知が許可されなかった */
"Notifications aren't allowed. Allow atme under Notifications in System Settings" = "As notificações não estão permitidas. Permita o atme em Notificações, nos Ajustes do Sistema";

/* ログ：.app の外の CLI では通知しない */
"Not sending notifications because atme was run outside atme.app" = "Nenhuma notificação enviada porque o atme foi executado fora do atme.app";

/* ログ：通知が許可されていない */
"Notifications aren't allowed. Open atme.app to allow them" = "As notificações não estão permitidas. Abra o atme.app para permiti-las";

/* ログ：通知の設定を読めない */
"Not sending notifications because the notification settings couldn't be read" = "Nenhuma notificação enviada porque não foi possível ler os ajustes de notificação";

/* ログ：通知の登録に失敗 */
"Couldn't send a notification: %@" = "Não foi possível enviar uma notificação: %@";

/* ログ：通知の登録が返ってこない */
"No response to the notification request" = "Sem resposta à solicitação de notificação";

/* CLI：atme list でキャッシュが無い */
"No cache. Run atme fetch" = "Sem cache. Execute atme fetch";

/* CLI：atme fetch のワークスペースごとの結果。%1$@ はワークスペース名、%2$@ は一覧の件数、%3$@ は新着の件数 */
"%1$@: %2$@ total, %3$@ new" = "%1$@: %2$@ no total, %3$@ novos";

/* token を Keychain に保存できない */
"Couldn't save service=%1$@ account=%2$@ to the Keychain" = "Não foi possível salvar service=%1$@ account=%2$@ nas Chaves";

/* token を Keychain から消せない */
"Couldn't delete service=%1$@ account=%2$@ from the Keychain" = "Não foi possível apagar service=%1$@ account=%2$@ das Chaves";

/* 同じワークスペースを 2 回足そうとした。%@ はワークスペース名 */
"%@ has already been added" = "%@ já foi adicionado";

/* 入れた値が user token ではない */
"Paste a User OAuth Token that starts with xoxp-" = "Cole um User OAuth Token que comece com xoxp-";

/* Slack の応答にワークスペースの URL が無い */
"auth.test didn't return the workspace URL" = "auth.test não retornou a URL do workspace";

/* メニュー：ワークスペースの追加・削除のウインドウを開く */
"Workspaces…" = "Workspaces…";

/* ウインドウの題 */
"Workspaces" = "Workspaces";

/* ウインドウ：ワークスペースを外すボタン */
"Remove" = "Remover";

/* ウインドウ：token を確かめて足すボタン */
"Add" = "Adicionar";

/* ウインドウ：token の入力欄の見出し（Slack の画面の表記に合わせて訳さない） */
"User OAuth Token" = "User OAuth Token";

/* ウインドウ：token を確かめているとき */
"Checking…" = "Verificando…";

/* ウインドウ：追加できたとき。%@ はワークスペース名 */
"Added %@" = "%@ adicionado";

/* ウインドウ：ワークスペースが 1 つも無いとき */
"No workspaces yet. Paste a token to add one." = "Nenhum workspace ainda. Cole um token para adicionar.";

/* ウインドウ：追加済みのワークスペースの一覧の見出し */
"Added Workspaces" = "Workspaces adicionados";

/* ウインドウ：token を入れて足す欄の見出し */
"Add a Workspace" = "Adicionar um workspace";

/* メニュー：ワークスペースが 1 つも無いとき。「ワークスペース…」はメニューの項目名に合わせる */
"No workspaces. Add one from Workspaces…" = "Nenhum workspace. Adicione um em “Workspaces…”";

/* 設定ファイルの workspace が [[workspace]] の表になっていない */
"workspace must be written as [[workspace]]" = "workspace deve ser escrito como [[workspace]]";

/* 削除の確認の題。%@ はワークスペース名 */
"Remove %@?" = "Remover %@?";

/* 削除の確認の説明 */
"The token is also deleted from the Keychain. You can add the workspace again by pasting the same token." = "O token também é apagado das Chaves. Você pode adicionar o workspace de novo colando o mesmo token.";

/* 削除の確認：何もしないボタン */
"Cancel" = "Cancelar";
