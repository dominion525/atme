/* キーは英語の文言そのもの（src/l10n.rs）。訳が無いときは英語のまま出る */

/* メニュー：アプリを終了する */
"Quit" = "退出";

/* メニュー：Sparkle で新しい版を確かめる */
"Check for Updates…" = "检查更新…";

/* メニュー：キャッシュのファイルが無いとき */
"No cache" = "没有缓存";

/* メニュー：1 度も取得に成功していないとき */
"Not fetched yet" = "尚未获取";

/* メニュー：最後に取得できた時刻。%@ は「10/28 19:05」の形 */
"Fetched %@" = "已获取 %@";

/* メニュー：取得全体の失敗。%@ はエラーの内容 */
"Fetch failed: %@" = "获取失败：%@";

/* メニュー：ワークスペースごとの取得の失敗。%1$@ はワークスペース名、%2$@ はエラーの内容 */
"Fetch failed: %1$@ (%2$@)" = "获取失败：%1$@（%2$@）";

/* メニュー：ログイン時の起動の切り替えの失敗。%@ は macOS のエラーの説明 */
"Couldn't change Open at Login (%@)" = "无法更改“登录时打开”（%@）";

/* メニュー：ワークスペースに未読が無いとき */
"None" = "无";

/* メニュー：一覧をすべて既読として外す */
"Mark All as Read" = "全部标为已读";

/* メニュー：すぐに取得する */
"Fetch Now" = "立即获取";

/* メニュー：前回の取得から間が無く、まだ押せないとき。%@ は残りの秒数 */
"Fetch Now (in %@s)" = "立即获取（%@ 秒后）";

/* メニュー：取得の順番を待っているとき */
"Waiting to Fetch" = "等待获取";

/* メニュー：取得しているとき */
"Fetching…" = "正在获取…";

/* メニュー：ログイン時に atme を起動する */
"Open at Login" = "登录时打开";

/* メニュー：ログイン時の起動に、システム設定での承認が要るとき */
"Open at Login (needs approval in System Settings)" = "登录时打开（需在“系统设置”中批准）";

/* 通知：個別に出さなかった残りの件数。%@ は件数 */
"And %@ more" = "另有 %@ 条未读消息";

/* メニューと通知：グループ DM の場所の名前 */
"Group DM" = "群组私信";

/* メニューと通知：本文が空のメッセージ */
"(no text)" = "（无正文）";

/* ファイルを読めなかった。%@ はファイルのパス */
"Couldn't read %@" = "无法读取 %@";

/* 設定や状態のファイルの中身が読み取れない。%@ はファイルのパス */
"The contents of %@ are invalid" = "%@ 的内容无效";

/* 設定ファイルで同じ name が 2 回ある。%@ は name */
"Workspace name %@ is duplicated" = "工作区名称 %@ 重复";

/* 環境変数 HOME が無い */
"HOME is not set" = "未设置 HOME";

/* Keychain に token が無いなど。%3$@ は security コマンドの出力 */
"Couldn't read service=%1$@ account=%2$@ from the Keychain: %3$@" = "无法从钥匙串读取 service=%1$@ account=%2$@：%3$@";

/* Keychain の値が文字列として読めない */
"The value of account=%@ in the Keychain isn't UTF-8" = "钥匙串中 account=%@ 的值不是 UTF-8";

/* ログ：チャンネルの既読の取得に失敗。%1$@ はチャンネル ID */
"Couldn't read the read state of %1$@: %2$@" = "无法读取 %1$@ 的已读状态：%2$@";

/* ログ：スレッドの既読の取得に失敗。%1$@ はチャンネル ID、%2$@ はスレッドの ts */
"Couldn't read the read state of thread %2$@ in %1$@: %3$@" = "无法读取 %1$@ 中消息列 %2$@ 的已读状态：%3$@";

/* HTTP の準備に失敗 */
"Couldn't create the HTTP client" = "无法创建 HTTP 客户端";

/* Slack の応答にスレッドの親が無い */
"conversations.replies didn't return the thread parent" = "conversations.replies 未返回消息列的父消息";

/* Slack の API に接続できない。%@ は API の名前 */
"Couldn't call %@" = "无法调用 %@";

/* Slack の API が HTTP のエラーを返した */
"%1$@ returned HTTP %2$@" = "%1$@ 返回了 HTTP %2$@";

/* Slack の応答を受け取れない */
"Couldn't read the response of %@" = "无法读取 %@ 的响应";

/* Slack の応答の形が想定と違う */
"Couldn't parse the response of %@" = "无法解析 %@ 的响应";

/* Slack の API がエラーを返した。%2$@ は Slack のエラーコード（訳さない） */
"%1$@ failed: %2$@" = "%1$@ 失败：%2$@";

/* 状態のファイルの保存先が無い */
"No directory to save to" = "没有用于保存的目录";

/* ディレクトリを作れない */
"Couldn't create %@" = "无法创建 %@";

/* ファイルの権限を変えられない */
"Couldn't set the permissions of %@" = "无法设置 %@ 的权限";

/* ファイルを開けない */
"Couldn't open %@" = "无法打开 %@";

/* ファイルに書けない */
"Couldn't write to %@" = "无法写入 %@";

/* 書いたファイルで置き換えられない */
"Couldn't replace %@" = "无法替换 %@";

/* CLI：atme fetch で失敗があった */
"Some workspaces failed to fetch" = "部分工作区获取失败";

/* ログ：users.info の失敗。%1$@ はワークスペース、%2$@ はユーザー ID */
"%1$@: couldn't look up the display name of %2$@: %3$@" = "%1$@：无法查询 %2$@ 的显示名称：%3$@";

/* ログ：自動アップデートの準備に失敗 */
"Couldn't load Sparkle.framework" = "无法加载 Sparkle.framework";

/* .app の外から引数なしで起動した */
"Can't stay in the menu bar because atme was run outside atme.app" = "由于 atme 在 atme.app 之外运行，无法常驻菜单栏";

/* 内部のエラー */
"Not running on the main thread" = "未在主线程上运行";

/* ログ：通知の許可の問い合わせに失敗 */
"Couldn't ask for notification permission: %@" = "无法请求通知权限：%@";

/* ログ：起動時に通知が許可されなかった */
"Notifications aren't allowed. Allow atme under Notifications in System Settings" = "未允许通知。请在“系统设置”的“通知”中允许 atme";

/* ログ：.app の外の CLI では通知しない */
"Not sending notifications because atme was run outside atme.app" = "由于 atme 在 atme.app 之外运行，不发送通知";

/* ログ：通知が許可されていない */
"Notifications aren't allowed. Open atme.app to allow them" = "未允许通知。请打开 atme.app 以允许通知";

/* ログ：通知の設定を読めない */
"Not sending notifications because the notification settings couldn't be read" = "无法读取通知设置，因此不发送通知";

/* ログ：通知の登録に失敗 */
"Couldn't send a notification: %@" = "无法发送通知：%@";

/* ログ：通知の登録が返ってこない */
"No response to the notification request" = "通知请求没有响应";

/* CLI：atme list でキャッシュが無い */
"No cache. Run atme fetch" = "没有缓存。请运行 atme fetch";

/* CLI：atme fetch のワークスペースごとの結果。%1$@ はワークスペース名、%2$@ は一覧の件数、%3$@ は新着の件数 */
"%1$@: %2$@ total, %3$@ new" = "%1$@：共 %2$@ 条，新消息 %3$@ 条";

/* token を Keychain に保存できない */
"Couldn't save service=%1$@ account=%2$@ to the Keychain" = "无法将 service=%1$@ account=%2$@ 保存到钥匙串";

/* token を Keychain から消せない */
"Couldn't delete service=%1$@ account=%2$@ from the Keychain" = "无法从钥匙串删除 service=%1$@ account=%2$@";

/* 同じワークスペースを 2 回足そうとした。%@ はワークスペース名 */
"%@ has already been added" = "%@ 已添加";

/* 入れた値が user token ではない */
"Paste a User OAuth Token that starts with xoxp-" = "请粘贴以 xoxp- 开头的 User OAuth Token";

/* Slack の応答にワークスペースの URL が無い */
"auth.test didn't return the workspace URL" = "auth.test 未返回工作区的 URL";

/* メニュー：ワークスペースの追加・削除のウインドウを開く */
"Workspaces…" = "工作区…";

/* ウインドウの題 */
"Workspaces" = "工作区";

/* ウインドウ：ワークスペースを外すボタン */
"Remove" = "移除";

/* ウインドウ：token を確かめて足すボタン */
"Add" = "添加";

/* ウインドウ：token を確かめているとき */
"Checking…" = "正在检查…";

/* ウインドウ：追加できたとき。%@ はワークスペース名 */
"Added %@" = "已添加 %@";

/* メニュー：ワークスペースが 1 つも無いとき。「ワークスペース…」はメニューの項目名に合わせる */
"No workspaces. Add one from Workspaces…" = "没有工作区。请从“工作区…”中添加";

/* 設定ファイルの workspace が [[workspace]] の表になっていない */
"workspace must be written as [[workspace]]" = "workspace 必须写成 [[workspace]] 的形式";

/* 削除の確認の題。%@ はワークスペース名 */
"Remove %@?" = "要移除 %@ 吗？";

/* 削除の確認の説明 */
"The token is also deleted from the Keychain. You can add the workspace again by pasting the same token." = "token 也会从钥匙串中删除。粘贴同一个 token 即可再次添加。";

/* 削除の確認：何もしないボタン */
"Cancel" = "取消";

/* ウインドウ：manifest を入れて Slack App を作る画面をブラウザで開くボタン */
"Create Slack App…" = "创建 Slack App…";

/* ウインドウ：追加済みのワークスペースが 1 つも無いとき */
"No workspaces" = "没有工作区";

/* ウインドウ：手順 1。右に「Slack App を作る…」のボタンが並ぶ */
"1. Create a Slack App for each workspace" = "1. 为每个工作区创建一个 Slack App";

/* ウインドウ：手順 2（Install to Workspace は Slack の画面の表記のまま） */
"2. Click Install to Workspace and copy the token" = "2. 点击 Install to Workspace 并复制 token";

/* ウインドウ：手順 3。下に token の入力欄と「追加」が並ぶ */
"3. Paste the copied token and add it" = "3. 粘贴复制的 token 并添加";
