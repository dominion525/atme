/* キーは英語の文言そのもの（src/l10n.rs）。訳が無いときは英語のまま出る */

/* メニュー：アプリを終了する */
"Quit" = "結束";

/* メニュー：Sparkle で新しい版を確かめる */
"Check for Updates…" = "檢查更新項目…";

/* メニュー：キャッシュのファイルが無いとき */
"No cache" = "沒有快取";

/* メニュー：ワークスペースが 1 つも分からず、表示するものも無いとき */
"No mentions or DMs" = "沒有提及或私訊";

/* メニュー：1 度も取得に成功していないとき */
"Not fetched yet" = "尚未取得";

/* メニュー：最後に取得できた時刻。%@ は「10/28 19:05」の形 */
"Fetched %@" = "已取得 %@";

/* メニュー：取得全体の失敗。%@ はエラーの内容 */
"Fetch failed: %@" = "取得失敗：%@";

/* メニュー：ワークスペースごとの取得の失敗。%1$@ はワークスペース名、%2$@ はエラーの内容 */
"Fetch failed: %1$@ (%2$@)" = "取得失敗：%1$@（%2$@）";

/* メニュー：ログイン時の起動の切り替えの失敗。%@ は macOS のエラーの説明 */
"Couldn't change Open at Login (%@)" = "無法變更「登入時打開」（%@）";

/* メニュー：ワークスペースに未読が無いとき */
"None" = "無";

/* メニュー：一覧をすべて既読として外す */
"Mark All as Read" = "全部標示為已讀";

/* メニュー：すぐに取得する */
"Fetch Now" = "立即取得";

/* メニュー：前回の取得から間が無く、まだ押せないとき。%@ は残りの秒数 */
"Fetch Now (in %@s)" = "立即取得（%@ 秒後）";

/* メニュー：取得の順番を待っているとき */
"Waiting to Fetch" = "等待取得";

/* メニュー：取得しているとき */
"Fetching…" = "正在取得…";

/* メニュー：ログイン時に atme を起動する */
"Open at Login" = "登入時打開";

/* メニュー：ログイン時の起動に、システム設定での承認が要るとき */
"Open at Login (needs approval in System Settings)" = "登入時打開（需在「系統設定」中核准）";

/* 通知：個別に出さなかった残りの件数。%@ は件数 */
"And %@ more" = "另有 %@ 則新訊息";

/* メニューと通知：グループ DM の場所の名前 */
"Group DM" = "群組私訊";

/* メニューと通知：本文が空のメッセージ */
"(no text)" = "（無內文）";

/* ファイルを読めなかった。%@ はファイルのパス */
"Couldn't read %@" = "無法讀取 %@";

/* 設定や状態のファイルの中身が読み取れない。%@ はファイルのパス */
"The contents of %@ are invalid" = "%@ 的內容無效";

/* 設定ファイルにワークスペースが無い */
"No [[workspace]] is configured" = "未設定任何 [[workspace]]";

/* 設定ファイルで同じ name が 2 回ある。%@ は name */
"Workspace name %@ is duplicated" = "工作空間名稱 %@ 重複";

/* 環境変数 HOME が無い */
"HOME is not set" = "未設定 HOME";

/* Keychain を読む security コマンドを動かせない */
"Couldn't run the security command" = "無法執行 security 指令";

/* Keychain に token が無いなど。%3$@ は security コマンドの出力 */
"Couldn't read service=%1$@ account=%2$@ from the Keychain: %3$@" = "無法從鑰匙圈讀取 service=%1$@ account=%2$@：%3$@";

/* Keychain の値が文字列として読めない */
"The value of account=%@ in the Keychain isn't UTF-8" = "鑰匙圈中 account=%@ 的值不是 UTF-8";

/* ログ：チャンネルの既読の取得に失敗。%1$@ はチャンネル ID */
"Couldn't read the read state of %1$@: %2$@" = "無法讀取 %1$@ 的已讀狀態：%2$@";

/* ログ：スレッドの既読の取得に失敗。%1$@ はチャンネル ID、%2$@ はスレッドの ts */
"Couldn't read the read state of thread %2$@ in %1$@: %3$@" = "無法讀取 %1$@ 中討論串 %2$@ 的已讀狀態：%3$@";

/* HTTP の準備に失敗 */
"Couldn't create the HTTP client" = "無法建立 HTTP 用戶端";

/* Slack の応答にスレッドの親が無い */
"conversations.replies didn't return the thread parent" = "conversations.replies 未傳回討論串的上層訊息";

/* Slack の API に接続できない。%@ は API の名前 */
"Couldn't call %@" = "無法呼叫 %@";

/* Slack の API が HTTP のエラーを返した */
"%1$@ returned HTTP %2$@" = "%1$@ 傳回了 HTTP %2$@";

/* Slack の応答を受け取れない */
"Couldn't read the response of %@" = "無法讀取 %@ 的回應";

/* Slack の応答の形が想定と違う */
"Couldn't parse the response of %@" = "無法解析 %@ 的回應";

/* Slack の API がエラーを返した。%2$@ は Slack のエラーコード（訳さない） */
"%1$@ failed: %2$@" = "%1$@ 失敗：%2$@";

/* 状態のファイルの保存先が無い */
"No directory to save to" = "沒有用於儲存的目錄";

/* ディレクトリを作れない */
"Couldn't create %@" = "無法建立 %@";

/* ファイルの権限を変えられない */
"Couldn't set the permissions of %@" = "無法設定 %@ 的權限";

/* ファイルを開けない */
"Couldn't open %@" = "無法打開 %@";

/* ファイルに書けない */
"Couldn't write to %@" = "無法寫入 %@";

/* 書いたファイルで置き換えられない */
"Couldn't replace %@" = "無法取代 %@";

/* CLI：atme fetch で失敗があった */
"Some workspaces failed to fetch" = "部分工作空間取得失敗";

/* ログ：users.info の失敗。%1$@ はワークスペース、%2$@ はユーザー ID */
"%1$@: couldn't look up the display name of %2$@: %3$@" = "%1$@：無法查詢 %2$@ 的顯示名稱：%3$@";

/* ログ：自動アップデートの準備に失敗 */
"Couldn't load Sparkle.framework" = "無法載入 Sparkle.framework";

/* .app の外から引数なしで起動した */
"Can't stay in the menu bar because atme was run outside atme.app" = "由於 atme 是在 atme.app 之外執行，無法常駐選單列";

/* 内部のエラー */
"Not running on the main thread" = "未在主執行緒上執行";

/* ログ：通知の許可の問い合わせに失敗 */
"Couldn't ask for notification permission: %@" = "無法要求通知權限：%@";

/* ログ：起動時に通知が許可されなかった */
"Notifications aren't allowed. Allow atme under Notifications in System Settings" = "未允許通知。請在「系統設定」的「通知」中允許 atme";

/* ログ：.app の外の CLI では通知しない */
"Not sending notifications because atme was run outside atme.app" = "由於 atme 是在 atme.app 之外執行，不傳送通知";

/* ログ：通知が許可されていない */
"Notifications aren't allowed. Open atme.app to allow them" = "未允許通知。請打開 atme.app 以允許通知";

/* ログ：通知の設定を読めない */
"Not sending notifications because the notification settings couldn't be read" = "無法讀取通知設定，因此不傳送通知";

/* ログ：通知の登録に失敗 */
"Couldn't send a notification: %@" = "無法傳送通知：%@";

/* ログ：通知の登録が返ってこない */
"No response to the notification request" = "通知要求沒有回應";

/* CLI：atme list でキャッシュが無い */
"No cache. Run atme fetch" = "沒有快取。請執行 atme fetch";
