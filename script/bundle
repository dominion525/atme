#!/bin/bash
# リリースビルドから target/release/atme.app を作って署名する。
# ATME_SIGN_IDENTITY に証明書の名前（一部でよい）を入れるとその証明書で、無ければ ad-hoc で署名する。
# アイコンは assets/icon.svg から作るので、rsvg-convert（brew install librsvg）が要る。
# 自動アップデートの Sparkle は、配布物をダウンロードして SHA256 を照らし合わせてから組み込む。
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$root/Cargo.toml" | head -n 1)
app="$root/target/release/atme.app"
iconset="$root/target/release/atme.iconset"
identity="${ATME_SIGN_IDENTITY:--}"

sparkle_version=2.10.1
sparkle_sha256=1a856d2a9edb8e628de88121d7be04cf0e2167f8641650b78fca00b14244cf27
sparkle_dir="$root/target/sparkle-$sparkle_version"
# appcast は gh-pages ブランチを GitHub Pages で配信する（blip と同じ形）
feed_url="https://atme.dominion525.com/appcast.xml"
# 更新の署名を確かめる公開鍵。秘密鍵は generate_keys --account atme でキーチェーンに入れたもの
sparkle_public_key="KhhV0ZkVYZZfZCw9F5CUEHVW9WPUnBvpGzOQyLpO4eI="

if ! command -v rsvg-convert > /dev/null; then
  echo "rsvg-convert が見つかりません。brew install librsvg で入れてください" >&2
  exit 1
fi

if [ ! -d "$sparkle_dir/Sparkle.framework" ]; then
  archive="$root/target/Sparkle-$sparkle_version.tar.xz"
  curl -fL -o "$archive" "https://github.com/sparkle-project/Sparkle/releases/download/$sparkle_version/Sparkle-$sparkle_version.tar.xz"
  echo "$sparkle_sha256  $archive" | shasum -a 256 -c -
  rm -rf "$sparkle_dir"
  mkdir -p "$sparkle_dir"
  tar -xJf "$archive" -C "$sparkle_dir"
fi

cargo build --release --manifest-path "$root/Cargo.toml"

rm -rf "$app" "$iconset"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$iconset"
cp "$root/target/release/atme" "$app/Contents/MacOS/atme"

for size in 16 32 128 256 512; do
  rsvg-convert -w "$size" -h "$size" "$root/assets/icon.svg" -o "$iconset/icon_${size}x${size}.png"
  rsvg-convert -w $((size * 2)) -h $((size * 2)) "$root/assets/icon.svg" -o "$iconset/icon_${size}x${size}@2x.png"
done
iconutil --convert icns --output "$app/Contents/Resources/atme.icns" "$iconset"

# 訳の文言（macOS 標準の Localizable.strings）。英語はキーそのものなので、訳のファイルは無い。
# Info.plist の CFBundleLocalizations も、ここにある言語から作る
localizations="    <string>en</string>"
for lproj in "$root"/resources/*.lproj; do
  ditto "$lproj" "$app/Contents/Resources/$(basename "$lproj")"
  localizations="$localizations
    <string>$(basename "$lproj" .lproj)</string>"
done

# メニューバーの絵（テンプレート画像）。表示は 18pt、Retina 用に @2x も作る。
# 取得中の絵は、いつもの絵を中心で 30 度ずつ時計回りに回した 12 枚（menubar-rotate-0 が回す前の絵）
frames="$root/target/release/menubar-frames"
rm -rf "$frames"
mkdir -p "$frames"
glyph=$(sed -n '/<path/p' "$root/assets/menubar/idle.svg")
for step in $(seq 0 11); do
  cat > "$frames/rotate-$step.svg" <<SVG
<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 36 36">
<g transform="rotate($((step * 30)) 18 18)">
$glyph
</g>
</svg>
SVG
done
for svg in "$root/assets/menubar/idle.svg" "$frames"/rotate-*.svg; do
  name="menubar-$(basename "$svg" .svg)"
  rsvg-convert -w 18 -h 18 "$svg" -o "$app/Contents/Resources/$name.png"
  rsvg-convert -w 36 -h 36 "$svg" -o "$app/Contents/Resources/$name@2x.png"
done
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleLocalizations</key>
  <array>
$localizations
  </array>
  <key>CFBundleExecutable</key>
  <string>atme</string>
  <key>CFBundleIconFile</key>
  <string>atme</string>
  <key>CFBundleIdentifier</key>
  <string>com.dominion525.atme</string>
  <key>CFBundleName</key>
  <string>atme</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$version</string>
  <key>CFBundleVersion</key>
  <string>$version</string>
  <key>LSUIElement</key>
  <true/>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <key>SUFeedURL</key>
  <string>$feed_url</string>
  <key>SUPublicEDKey</key>
  <string>$sparkle_public_key</string>
</dict>
</plist>
PLIST

# Sparkle の部品は、公式の手順どおり --deep を使わずに 1 つずつ署名してから、.app 全体を署名する
mkdir -p "$app/Contents/Frameworks"
ditto "$sparkle_dir/Sparkle.framework" "$app/Contents/Frameworks/Sparkle.framework"
sparkle="$app/Contents/Frameworks/Sparkle.framework/Versions/B"
codesign --force --options runtime --sign "$identity" "$sparkle/XPCServices/Installer.xpc"
codesign --force --options runtime --sign "$identity" --preserve-metadata=entitlements "$sparkle/XPCServices/Downloader.xpc"
codesign --force --options runtime --sign "$identity" "$sparkle/Autoupdate"
codesign --force --options runtime --sign "$identity" "$sparkle/Updater.app"
codesign --force --options runtime --sign "$identity" "$app/Contents/Frameworks/Sparkle.framework"

codesign --force --options runtime --sign "$identity" "$app"
echo "$app"
