#!/bin/bash
# リリースビルドから target/release/atme.app を作って署名する。
# ATME_SIGN_IDENTITY に証明書の名前（一部でよい）を入れるとその証明書で、無ければ ad-hoc で署名する。
# アイコンは assets/icon.svg から作るので、rsvg-convert（brew install librsvg）が要る。
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$root/Cargo.toml" | head -n 1)
app="$root/target/release/atme.app"
iconset="$root/target/release/atme.iconset"

if ! command -v rsvg-convert > /dev/null; then
  echo "rsvg-convert が見つかりません。brew install librsvg で入れてください" >&2
  exit 1
fi

cargo build --release --manifest-path "$root/Cargo.toml"

rm -rf "$app" "$iconset"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources" "$iconset"
cp "$root/target/release/atme" "$app/Contents/MacOS/atme"

for size in 16 32 128 256 512; do
  rsvg-convert -w "$size" -h "$size" "$root/assets/icon.svg" -o "$iconset/icon_${size}x${size}.png"
  rsvg-convert -w $((size * 2)) -h $((size * 2)) "$root/assets/icon.svg" -o "$iconset/icon_${size}x${size}@2x.png"
done
iconutil --convert icns --output "$app/Contents/Resources/atme.icns" "$iconset"

# メニューバーの絵（テンプレート画像）。表示は 18pt、Retina 用に @2x も作る。
# 取得中の絵は、いつもの絵を中心で 30 度ずつ時計回りに回した 12 枚（menubar-rotate-0 が回す前の絵）
frames="$root/target/release/menubar-frames"
rm -rf "$frames"
mkdir -p "$frames"
glyph=$(sed -n '/<path/p' "$root/assets/menubar/idle.svg")
for step in $(seq 0 11); do
  cat > "$frames/rotate-$step.svg" <<SVG
<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 36 36">
<g transform="rotate($((step * 30)) 18 18)">
$glyph
</g>
</svg>
SVG
done
for svg in "$root/assets/menubar/idle.svg" "$frames"/rotate-*.svg; do
  name="menubar-$(basename "$svg" .svg)"
  rsvg-convert -w 18 -h 18 "$svg" -o "$app/Contents/Resources/$name.png"
  rsvg-convert -w 36 -h 36 "$svg" -o "$app/Contents/Resources/$name@2x.png"
done
cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key>
  <string>atme</string>
  <key>CFBundleIconFile</key>
  <string>atme</string>
  <key>CFBundleIdentifier</key>
  <string>com.dominion525.atme</string>
  <key>CFBundleName</key>
  <string>atme</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$version</string>
  <key>CFBundleVersion</key>
  <string>$version</string>
  <key>LSUIElement</key>
  <true/>
</dict>
</plist>
PLIST

codesign --force --options runtime --sign "${ATME_SIGN_IDENTITY:--}" "$app"
echo "$app"
