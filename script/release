#!/bin/bash
# Developer ID で署名・公証した atme.app の zip と、Sparkle の appcast を target/dist に作る。
# 公証の認証情報は NOTARY_KEYCHAIN_PROFILE（既定 notarytool。xcrun notarytool store-credentials で保存したもの）、
# 署名の証明書は ATME_SIGN_IDENTITY（既定 Developer ID Application）、
# 更新の署名は、キーチェーンにある Sparkle の鍵（generate_keys --account atme）を使う。
# 版は Cargo.toml の version。リリースのたびに上げる（Sparkle は Info.plist の版で新旧を比べる）。
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
version=$(sed -n 's/^version = "\(.*\)"$/\1/p' "$root/Cargo.toml" | head -n 1)
sparkle_version=$(sed -n 's/^sparkle_version=//p' "$root/script/bundle")
profile="${NOTARY_KEYCHAIN_PROFILE:-notarytool}"
export ATME_SIGN_IDENTITY="${ATME_SIGN_IDENTITY:-Developer ID Application}"
app="$root/target/release/atme.app"
dist="$root/target/dist"
download_prefix="https://github.com/dominion525/atme/releases/download/v$version/"

if [ -n "$(git -C "$root" status --porcelain)" ]; then
  echo "未コミットの変更があります。コミットしてからリリースしてください" >&2
  exit 1
fi

echo "==> build atme $version"
"$root/script/bundle"

echo "==> notarize"
submission="$root/target/notarize/atme.zip"
mkdir -p "$(dirname "$submission")"
rm -f "$submission"
ditto -c -k --keepParent "$app" "$submission"
result=$(xcrun notarytool submit "$submission" --keychain-profile "$profile" --wait --output-format json)
status=$(echo "$result" | sed -n 's/.*"status":"\([^"]*\)".*/\1/p')
if [ "$status" != "Accepted" ]; then
  echo "公証が通りませんでした（status: ${status:-不明}）: $result" >&2
  exit 1
fi
xcrun stapler staple "$app"
xcrun stapler validate "$app"
spctl -a -vvv -t exec "$app"

echo "==> package"
mkdir -p "$dist"
zip="$dist/atme-$version.zip"
rm -f "$zip"
ditto -c -k --keepParent "$app" "$zip"

echo "==> appcast"
"$root/target/sparkle-$sparkle_version/bin/generate_appcast" --account atme --download-url-prefix "$download_prefix" "$dist"

echo "==> done"
echo "$zip"
echo "$dist/appcast.xml"
