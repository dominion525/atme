{
  "display_information": {
    "name": "atme",
    "description": "Never miss Slack mentions and DMs addressed to you",
    "background_color": "#2a2a2d"
  },
  "oauth_config": {
    "scopes": {
      "user": [
        "search:read",
        "users:read",
        "channels:read",
